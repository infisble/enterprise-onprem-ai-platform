# ------------------------------------------------------------------------------------------
# NovaPromo AI platform configuration. Copy to .env and adjust.
# Empty infrastructure URLs => embedded fallbacks (SQLite, embedded Qdrant, in-process BM25,
# in-memory cache) so the platform also runs without Docker.
# ------------------------------------------------------------------------------------------

# Host ports published by docker compose (only web + api are exposed)
API_PORT=8000
WEB_PORT=3000
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090

# Security - CHANGE for anything beyond a local demo
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
DEMO_PASSWORD=demo
POSTGRES_PASSWORD=novapromo
ANALYTICS_RO_PASSWORD=analytics_ro
GRAFANA_PASSWORD=admin

LOG_LEVEL=INFO

# --- LLM provider: mock | openai | vllm --------------------------------------------------
LLM_PROVIDER=mock
# Use LLM tool-calling for routing (only with a real provider); rules are the default
LLM_ROUTING=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# vLLM (OpenAI-compatible) - point at the on-prem NVIDIA server, e.g. http://gpu-server:8001/v1
VLLM_BASE_URL=http://vllm:8000/v1
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
VLLM_API_KEY=EMPTY
VLLM_MAX_MODEL_LEN=16384
VLLM_GPU_MEMORY_UTILIZATION=0.90
HF_TOKEN=

# --- Embeddings: hash (offline) | openai_compatible (TEI / vLLM / OpenAI) | fastembed --------
EMBEDDING_PROVIDER=hash
EMBEDDING_BASE_URL=http://gpu-server:8002/v1
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=512

# --- Reranker: feature (deterministic) | cross_encoder (local) | http (TEI /rerank) ----------
RERANKER_PROVIDER=feature
RERANKER_URL=http://gpu-server:8003/rerank

# --- Local (non-Docker) run only: leave empty for embedded fallbacks ------------------------
# DATABASE_URL=sqlite:///./.data/novapromo.db
# DATABASE_URL=mssql+pyodbc://user:pass@sqlserver/NovaPromo?driver=ODBC+Driver+18+for+SQL+Server
# QDRANT_URL=
# ELASTICSEARCH_URL=
# REDIS_URL=
# BATCH_MODE=inline
